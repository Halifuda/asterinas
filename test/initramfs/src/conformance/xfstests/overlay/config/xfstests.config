# SPDX-License-Identifier: MPL-2.0

# Host config describes the filesystem on TEST_DEV/SCRATCH_DEV. The `check
# -overlay` command-line mode switches the active test filesystem to overlay
# and preserves this base type through OVL_BASE_* variables.
export FSTYP=ext2
export OVL_BASE_FSTYP=ext2

# The xfstests images are attached after the ext2, exFAT, and LTP images and
# appear as /dev/vdd and /dev/vde in the guest.
export TEST_DEV=${XFSTESTS_TEST_DEV:-/dev/vdd}
export SCRATCH_DEV=${XFSTESTS_SCRATCH_DEV:-/dev/vde}

# These are the mount roots for the ext2 filesystems. Upstream common/overlay
# creates ovl-lower, ovl-upper, ovl-work, and ovl-mnt below them.
export TEST_DIR=/opt/xfstests/test
export SCRATCH_MNT=/opt/xfstests/scratch

# Keep both the base ext2 mounts and overlay mounts free of filesystem-specific
# options while validating the old Asterinas overlayfs implementation.
export MOUNT_OPTIONS=""
export EXT_MOUNT_OPTIONS=""
export OVL_BASE_MOUNT_OPTIONS=""
export FSTYP_HAS_NON_DEFAULT_OPTS=0
export SELINUX_MOUNT_OPTIONS=" "
export MKFS_OPTIONS=""
